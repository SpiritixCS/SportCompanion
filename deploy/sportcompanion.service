[Unit]
Description=SportCompanion
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/sportcompanion/.next/standalone
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
Environment=DATA_DIR=/home/ubuntu/sportcompanion/data
Environment=MIGRATIONS_DIR=/home/ubuntu/sportcompanion/.next/standalone/migrations
EnvironmentFile=-/home/ubuntu/sportcompanion/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
